rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{product} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.toLowerCase() == "patiencexavier66@gamil.com";
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.toLowerCase() == "patiencexavier66@gamil.com";
    }
    match /promo_codes/{code} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.toLowerCase() == "patiencexavier66@gamil.com";
    }
  }
}
